# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ------------------------------------------------------------------
# API keys (required for production)
# ------------------------------------------------------------------
# Comma-separated list of valid Bearer tokens.
# Leave empty to run in open/dev mode (not safe for production).
OCP_API_KEYS=your-secret-key-here

# Optional: restrict each key to specific workspace IDs.
# Format: key1:ws_id1,ws_id2;key2:ws_id3
# OCP_API_KEY_WORKSPACES=

# ------------------------------------------------------------------
# Database (defaults to SQLite if unset)
# ------------------------------------------------------------------
# OCP_DATABASE_URL=postgresql://ocp:ocp_dev_password@localhost:5432/ocp

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
# OCP_HOST=0.0.0.0
# OCP_PORT=8080

# ------------------------------------------------------------------
# Embedder backend (hash = built-in, no deps; fastembed or openai for production)
# ------------------------------------------------------------------
# OCP_EMBEDDER=hash

# ------------------------------------------------------------------
# File watching (set to 0 in tests or containers without a real FS)
# ------------------------------------------------------------------
# OCP_WATCH=1
